AEMET_API_KEY=tu_api_key_de_aemet
PORT=3000
# Carpeta de la caché. En producción apunta a un volumen persistente (p. ej. /data/cache).
CACHE_DIR=./.cache
FETCH_TIMEOUT_MS=20000
AEMET_REQUEST_DELAY_MS=1000
RECENT_DATA_TTL_HOURS=12
EVOLUTION_JOB_RETENTION_MINUTES=45
EVOLUTION_ENQUEUE_LIMIT_PER_MIN=40
EVOLUTION_STATUS_LIMIT_PER_MIN=240
# MongoDB Atlas: usuario con lectura y escritura (carga inicial y tarea diaria) y usuario de solo lectura (web).
MONGODB_URI_WRITE=mongodb+srv://escritor:contraseña@tu-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI_READ=mongodb+srv://lector:contraseña@tu-cluster.mongodb.net/?retryWrites=true&w=majority

# Publicación diaria en Bluesky (tarea programada de Vercel). La contraseña es una «contraseña de aplicación», no la de la cuenta.
BLUESKY_HANDLE=tuusuario.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Clave que Vercel envía a /api/cron/bluesky. Genérala con: openssl rand -hex 32
CRON_SECRET=
