AEMET_API_KEY=tu_api_key_de_aemet
PORT=3000
# Carpeta de la caché. En producción apunta a un volumen persistente (p. ej. /data/cache).
CACHE_DIR=./.cache
FETCH_TIMEOUT_MS=20000
REFRESH_SECRET=pon_aqui_un_secreto_largo_y_unico
AEMET_REQUEST_DELAY_MS=1000
RECENT_DATA_TTL_HOURS=12
EVOLUTION_JOB_RETENTION_MINUTES=45
EVOLUTION_SYNC_LIMIT_PER_MIN=12
EVOLUTION_ENQUEUE_LIMIT_PER_MIN=40
EVOLUTION_STATUS_LIMIT_PER_MIN=240
